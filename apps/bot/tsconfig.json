{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@vyntric/shared": ["../../packages/shared/dist/index.d.ts"],
      "@vyntric/db": ["../../packages/db/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
