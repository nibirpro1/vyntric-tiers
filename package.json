{
  "name": "vyntric-tiers",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bot:dev": "npx tsx apps/bot/src/index.ts",
    "bot:build": "npm run --prefix packages/shared build && npm run --prefix packages/db build && npm run --prefix apps/bot build",
    "bot:start": "node apps/bot/dist/index.js",
    "bot:deploy": "npx tsx apps/bot/src/deploy-commands.ts",
    "bot:setup": "npx tsx apps/bot/src/scripts/setup-guild.ts",
    "db:generate": "node ./node_modules/prisma/build/index.js generate --schema=packages/db/prisma/schema.prisma",
    "db:seed": "npx tsx packages/db/src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.2",
    "@supabase/supabase-js": "^2.118.0",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "discord.js": "^14.28.0",
    "dotenv": "^18.0.9",
    "framer-motion": "^11.11.11",
    "fuse.js": "^7.0.0",
    "gsap": "^3.12.5",
    "lenis": "^1.1.14",
    "lucide-react": "^0.454.0",
    "next": "14.2.18",
    "prisma": "^5.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.13.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.169.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
